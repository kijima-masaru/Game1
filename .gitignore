# Godot 4 が生成するキャッシュ
.godot/
/android/

# エクスポート成果物
/build/
/export/
*.pck
*.zip
*.exe
*.dmg
*.apk
*.aab

# ローカルにインストールした Godot バイナリ
/.godot-bin/

# OS / エディタ
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# 参考画像（リポジトリには含めない）
/refs/

# lookdev の個別ショット（tools/lookdev_shots.py で再生成できる。シートだけ残す）
/docs/lookdev/shots/

# Python ツールのキャッシュ
__pycache__/

# lookdev の GIF/連番（大きい。tools/lookdev_c.py で再生成）
/docs/lookdev/video/

# フィールドの生成物（AO 等）。tools/ か起動時に再生成できる。配布ビルドには焼き込む（FIELD_FORMAT.md 第 8 節）
/cache/
